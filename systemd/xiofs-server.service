[Unit]
Description=XIOFS POSIX HTTP export (XrdHttp2 + setfsuid)
Documentation=man:xrootd(8)
After=network-online.target local-fs.target time-sync.target
Wants=network-online.target local-fs.target

[Service]
Type=simple
Environment="TZ=:/etc/localtime"
EnvironmentFile=-/etc/default/xrootd
EnvironmentFile=-/etc/sysconfig/xrootd
ExecStart=/usr/bin/xiofs-server -c /etc/xrootd/xiofs-server.conf
KillMode=control-group
LimitNOFILE=524288
Restart=on-abnormal
RestartSec=10
RuntimeDirectory=xiofs-server
RuntimeDirectoryMode=0755
LogsDirectory=xrootd
LogsDirectoryMode=0750
SyslogIdentifier=xiofs-server
# Starts as root, then xrootd-fsuid drops to user= (default xrootd) while
# keeping CAP_SETUID for FsOss impersonation.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
