#!/bin/sh
set -e

if [ "$1" = "configure" ] && [ -x /usr/sbin/dkms ]; then
    for d in /usr/src/xiofs-*; do
        [ -d "$d" ] || continue
        ver=${d#/usr/src/xiofs-}
        /usr/sbin/dkms add -m xiofs -v "$ver" >/dev/null 2>&1 || true
        /usr/sbin/dkms install -m xiofs -v "$ver" >/dev/null 2>&1 || true
    done
fi

#DEBHELPER#

exit 0
